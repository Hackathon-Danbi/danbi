{
  "expo": {
    "name": "단비",
    "slug": "danbi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "danbi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성으로 송금하고 안내를 이용하려면 마이크 접근이 필요합니다.",
          "speechRecognitionPermission": "말씀하신 송금 내용을 문자로 바꾸기 위해 음성 인식 권한이 필요합니다.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as",
            "com.samsung.android.bixby.agent"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "음성 질문과 송금 연습을 위해 마이크 접근이 필요합니다.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "저장된 사진에서 계좌번호를 찾으려면 사진 접근이 필요합니다.",
          "cameraPermission": "신분증·얼굴 확인과 계좌 사진 촬영을 위해 카메라 접근이 필요합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "신분증과 얼굴을 확인하려면 카메라가 필요해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
